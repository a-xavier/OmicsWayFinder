import sys

if not (sys.version_info >= (3, 7)):
    print("Python >= 3.7 supported")
    sys.exit(1)

__version_info__ = ('3','1','0')
__version__ = '.'.join(__version_info__)

import re
import argparse
import subprocess
import time
